<?xml version="1.0" encoding="utf-8"?>
<!--
  Quarantine review (todo.md T2). Held unknown-sender threads, hidden from
  the main list. Tap a row to deliver, block, or delete.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quarantine_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/txxt_edge_inset"
        android:paddingEnd="@dimen/txxt_edge_inset">

        <TextView
            android:id="@+id/quarantine_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="12dp"
            android:fontFamily="@font/font_body"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:text="Held messages" />

        <TextView
            android:id="@+id/quarantine_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:fontFamily="@font/font_body"
            android:textSize="12sp"
            android:textColor="#80FFFFFF"
            android:text="Tap a sender to deliver, block, or delete. Starred senders never land here." />

        <TextView
            android:id="@+id/quarantine_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp"
            android:gravity="center"
            android:fontFamily="@font/font_body"
            android:textSize="14sp"
            android:textColor="#80FFFFFF"
            android:text="Nothing held."
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/quarantine_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp"
            android:clipToPadding="false" />

    </LinearLayout>

</LinearLayout>
