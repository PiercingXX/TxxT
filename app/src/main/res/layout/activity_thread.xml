<?xml version="1.0" encoding="utf-8"?>
<!--
  TxxT conversation thread (T2).

  Text-first message lines on AMOLED black (docs/DESIGN.md §"Conversation
  thread"). No chat bubbles, no rounded cards — the no-bubble constraint is
  structural (docs/PRIVACY.md §2). The message list is a RecyclerView filled by
  ThreadAdapter (T3); a slim top bar carries the settings affordance and the
  compose bar sits at the bottom, carrying attach / input / send plus a
  text-first indicator line for a staged photo. NO voice-message affordance and no dictation
  mic (docs/PRIVACY.md §5 — voice messages are never sent or received; the
  dictation seam classes remain, but the thread screen exposes no entry point).

  Buttons are borderless: no filled background, just a bright-white monospace
  glyph on the ground — a hard white pill would out-shout the text-first lines
  (docs/DESIGN.md — the accent is reserved for type, not for chrome).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/thread_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    android:fitsSystemWindows="true">

    <!-- Top bar: the thread's title on the left, the settings affordance
         top-right and off the compose bar, so the compose row stays input +
         send only. -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="4dp">

        <!-- Who this thread is with. ThreadActivity fills it with the
             participant's saved contact name (ContactNameResolver via
             ConversationListPresenter.title) and falls back to the raw number
             when there is no contact or no permission — so this line is never
             blank. Text-first: a title line, not an action bar. -->
        <TextView
            android:id="@+id/thread_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/font_body"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#E6FFFFFF"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Settings affordance: opens the settings screen (WS12 T5).
             Borderless — a white glyph, no filled background. -->
        <Button
            android:id="@+id/settings_button"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙"
            android:textSize="18sp"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <SearchView
        android:id="@+id/thread_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:queryHint="Search this thread" />

    <!-- Message list. Flat text-first rows, never bubbles. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/message_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:clipToPadding="false" />

    <!-- Compose bar: an attachment indicator line above the compose row. The
         glyphs are ⊕ (U+2295, attach), ➜ (U+279C, send) and ✕ (U+2715, remove
         the attachment) — all three are codepoints the bundled @font/font_body
         (JetBrains Mono) actually maps in its cmap, checked against the font
         binary rather than assumed, so they render as monochrome type from our
         own face and never fall through to a colour-emoji font. A paperclip
         emoji is NOT in that cmap and is deliberately not used. -->
    <LinearLayout
        android:id="@+id/compose_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#09090B"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- Attachment indicator. Hidden until a photo is picked; then it names
             what is attached as a LINE OF TYPE — this app has no bubbles and no
             cards (docs/PRIVACY.md §2), so an attachment announces itself the
             way everything else here does, as text. The ✕ removes the staged
             photo outright, so nothing has to be sent to get rid of it. -->
        <LinearLayout
            android:id="@+id/attachment_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/attachment_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/font_body"
                android:textSize="13sp"
                android:textColor="#80FFFFFF"
                android:maxLines="1"
                android:ellipsize="middle" />

            <Button
                android:id="@+id/attachment_clear"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:fontFamily="@font/font_body"
                android:text="✕"
                android:textSize="15sp"
                android:contentDescription="Remove the attached photo"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Compose row: attach, the text field, send. -->
        <LinearLayout
            android:id="@+id/compose_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Attach a photo. Borderless bright-white glyph, the same
                 treatment the send affordance gets — no filled pill, no vector
                 icon. Opens the Android photo picker, which needs NO storage
                 permission: the operator picks one photo and the app is given
                 access to that one item and nothing else. -->
            <Button
                android:id="@+id/attach_button"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:layout_marginEnd="4dp"
                android:fontFamily="@font/font_body"
                android:text="⊕"
                android:textSize="18sp"
                android:contentDescription="Attach a photo"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/emoji_button"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:layout_marginEnd="4dp"
                android:text=""
                android:textSize="18sp"
                android:contentDescription="Insert emoji"
                android:textColor="#FFFFFF" />

            <EditText
                android:id="@+id/compose_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Message"
                android:textColor="#E6FFFFFF"
                android:textColorHint="#80FFFFFF"
                android:background="#18181B"
                android:padding="10dp"
                android:inputType="textShortMessage|textMultiLine"
                android:maxLines="4" />

            <Button
                android:id="@+id/send_button"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/font_body"
                android:text="➜"
                android:textSize="18sp"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
