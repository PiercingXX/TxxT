<?xml version="1.0" encoding="utf-8"?>
<!--
  TxxT single message row (T2).

  A text-first line, never a chat bubble (docs/DESIGN.md §"Conversation
  thread", docs/PRIVACY.md §2 — "nothing ever bubbles"). Alignment is driven by
  the message column's layout_gravity inside this FrameLayout: inbound LEFT,
  outbound RIGHT (ThreadMessagePresenter maps direction → alignment, and
  ThreadAdapter.applyAlignment writes it onto the column's LayoutParams on
  every bind). The start value below is the inbound default; it is NOT the
  live value — a bound row always carries the direction's own gravity.
  There is deliberately NO bubble/card background and NO rounded-corner
  drawable — the row is bare text on AMOLED black.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:id="@+id/message_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:orientation="vertical">

        <!-- Message body. Emphasis comes from the white-opacity ramp, never hue:
             sent = signal-white text (inverted), received = slate/graphite muted.
             The adapter sets text colour from ThreadRow.emphasis. -->
        <ImageView
            android:id="@+id/message_photo"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:maxHeight="220dp"
            android:scaleType="fitStart"
            android:visibility="gone"
            android:contentDescription="Photo" />

        <TextView
            android:id="@+id/message_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="#E6FFFFFF"
            android:lineSpacingMultiplier="1.15" />

        <!-- Timestamp in monospace, muted. -->
        <TextView
            android:id="@+id/message_timestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/font_body"
            android:textSize="11sp"
            android:textColor="#80FFFFFF" />
    </LinearLayout>

</FrameLayout>