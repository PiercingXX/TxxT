<?xml version="1.0" encoding="utf-8"?>
<!--
  TxxT launcher conversation list (WS10).

  The launcher's conversation-list host. The list is a RecyclerView identified
  as recyclerView — the runtime ID MainActivity resolves via
  findViewById<RecyclerView>(R.id.recyclerView), fills through
  ConversationListAdapter, and hosts the swipe helper on. Text-first on AMOLED
  black (docs/DESIGN.md §"Conversation thread").
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Conversation search (T3). The SearchView widget whose query listener
             MainActivity wires into applySearchQuery → filterConversations. -->
        <SearchView
            android:id="@+id/searchView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:queryHint="Search conversations" />

        <!-- New-conversation affordance: prompts for a number and opens (or
             creates) its thread. Text-first — a monospace word, not an icon,
             and borderless: a bright-white word on the ground, no filled pill. -->
        <Button
            android:id="@+id/new_message_button"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/font_body"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:text="NEW" />

        <Button
            android:id="@+id/settings_button"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="⚙"
            android:textSize="18sp"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <TextView
        android:id="@+id/role_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:fontFamily="@font/font_body"
        android:textSize="13sp"
        android:textColor="#FFFFFF"
        android:text="TxxT is not the default SMS app. Tap to set it."
        android:visibility="gone" />

    <!-- Shown instead of an empty list; MainActivity toggles visibility. -->
    <TextView
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:gravity="center"
        android:fontFamily="@font/font_body"
        android:textSize="14sp"
        android:textColor="#80FFFFFF"
        android:text="No conversations yet.\nNEW starts one.\nSet TxxT as the default SMS app to receive messages."
        android:visibility="gone" />

    <!-- Conversation list. The runtime view ID MainActivity resolves and the
         swipe helper (T1) attaches to. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        android:clipToPadding="false" />

</LinearLayout>
