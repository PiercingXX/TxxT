<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The SMS permissions below imply telephony hardware; declare it
         explicitly (not hard-required) so devices without telephony — e.g.
         ChromeOS — can still install, per lint
         PermissionImpliesUnsupportedChromeOsHardware. -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!-- Default-SMS-handler role. Declaring this permission makes the app
         eligible to be offered as the default SMS handler by the OS. The
         role-completing components now exist in this manifest:
           - .service.SmsDeliverReceiver   (Telephony.SMS_DELIVER)
           - .service.MmsDeliverReceiver   (Telephony.WAP_PUSH_DELIVER)
           - .ui.ComposeActivity           (ACTION_SENDTO sms:/smsto:/mms:/mmsto:)
           - .service.RespondViaMessageService (ACTION_RESPOND_VIA_MESSAGE)
         Runtime grant happens via a RoleManager request — an on-device step. -->
    <uses-permission android:name="android.permission.role.SMS" />

    <!-- Runtime notification permission (API 33+). Requested alongside the
         SMS-role grant so the app can surface its own notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- SMS/MMS runtime permissions. RECEIVE_SMS + RECEIVE_MMS let the receivers
         in service/ observe inbound SMS/MMS broadcasts; SEND_SMS lets the send
         pipeline send. READ_SMS/WRITE_SMS complete the default-SMS-handler role:
         inbound delivery persists through the data layer (InboundStore), blocked
         senders are dropped before any write, and MMS content stays
         tap-initiated (docs/PRIVACY.md §8.1). -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_MMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.WRITE_SMS" />
    <!-- Default-SMS role completeness. SmsApplication treats these as part
         of the SMS-app set; without the declarations the OS logs
         "lost … (fixing)" and auto-grants them anyway. RECEIVE_WAP_PUSH is
         the app-level pair to the WAP_PUSH receivers already in this
         manifest. READ_CELL_BROADCASTS is declared so the role check is
         complete — TxxT does not read, store, or display cell-broadcast /
         WEA payloads; those stay with the platform CellBroadcastReceiver. -->
    <uses-permission android:name="android.permission.RECEIVE_WAP_PUSH" />
    <uses-permission android:name="android.permission.READ_CELL_BROADCASTS" />

    <!-- Contact-name resolution AND the NEW-conversation recipient picker.
         READ-ONLY, LOCAL-ONLY, and the app stays fully usable without it.
         TxxT reads the system contacts provider — the same store the dialer
         reads; there is no separate dialer-private contact list — in two
         ways: ContactsContract.PhoneLookup to turn a raw number into the
         name the operator saved for it (contacts/ContactNameResolver.kt),
         and CommonDataKinds.Phone to list saved numbers so NEW can search
         by contact name (contacts/ContactDirectory.kt). Without it every
         saved contact renders as a bare number and NEW is number-entry only.

         What this permission does NOT license: no write (no CONTACTS write
         permission is declared, so nothing in the contacts database can be
         changed) and no enrichment — both queries are local provider reads
         against contacts the operator saved themselves, never a fetch to
         decorate an unknown number (docs/PRIVACY.md §8.3 "no reverse-lookup,
         no contact enrichment"; §10). Denial is a first-class path: the
         resolver falls back to the number, never to a blank row, and the
         picker still accepts a typed number (the never-silent-failure rule
         the PermissionGate seams follow). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Boot-time reconcile (T2). Lets the BootReceiver run the reboot reconcile
         (rebuild unread counts, re-drive pending sends) when the device finishes
         booting. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Foreground service while an inbound photo is fetched from the MMSC.
         WAP_PUSH_DELIVER's goAsync window is too short for Verizon's GET;
         without this the retrieve is killed in the background and the photo
         never lands. remoteMessaging is the SMS-app type (API 34+). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />

    <!-- Family theme-sync. XX-Launcher defines and sendBroadcast()s with this
         signature permission; uses-permission is required to receive it. -->
    <uses-permission android:name="com.piercingxx.xxlauncher.permission.THEME_SYNC" />

    <!-- XX-Dialer's Business-tier export. Signature; declare+uses so install
         order against the dialer does not drop the grant. -->
    <permission
        android:name="com.piercingxx.xxdialer.permission.TIER_SYNC"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.piercingxx.xxdialer.permission.TIER_SYNC" />

    <!-- Deliberately NO RECORD_AUDIO permission. WS13 declared it for the
         compose bar's dictation mic; the compose-bar rework deleted that
         button, and it was the feature's only entry point — ThreadActivity
         wires no SpeechRecognizer and nothing in the app calls
         PermissionGate.canRecord. A permission the shipping code cannot
         exercise is one the user is asked for and gets nothing from, so it is
         gone: the permission list stays exactly the set the app actually uses
         (docs/PRIVACY.md §5). The pure DictationInsert seam survives for a
         future entry point — declaring the mic again is part of re-wiring one.

         Every permission above carries the comment that justifies it, and
         scripts/verify_privacy_claims.py asserts the built APK's list matches
         this one exactly — so a permission cannot arrive through a library's
         manifest merge, and cannot outlive the feature it was added for. -->

    <!-- NoActionBar: the surfaces are full-bleed AMOLED black text-first
         layouts (docs/DESIGN.md) — no title bar may sit above them. Theme.TxxT
         binds the txxt* color attributes the UI reads (values/themes.xml). -->
    <application
        android:name=".TxxtApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TxxT">

        <!-- Launcher entry. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Conversation thread. Not exported: launched only by MainActivity /
             the notification content intent, never by external apps. -->
        <activity
            android:name=".ui.ThreadActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize" />

        <!-- NEW-conversation recipient picker. Not exported: launched only by
             MainActivity's NEW affordance.
             adjustResize keeps the contact list above the keyboard so typing
             a name and seeing matches is one motion. -->
        <activity
            android:name=".ui.NewConversationActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize|stateVisible" />

        <!-- Settings screen. Not exported: launched only by ThreadActivity's
             settings affordance, never by external apps.
             Persists the SettingsStore through SharedPreferences. -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="@string/title_settings" />

        <!-- Blocking & starred editor. Not exported: launched only by the
             settings screen's blocking affordance.
             Edits apply to the live inbound filter immediately. -->
        <activity
            android:name=".ui.BlockingActivity"
            android:exported="false"
            android:label="@string/title_blocking" />

        <!-- Quarantine review. Not exported: launched only from the
             launcher banner or the blocking screen. -->
        <activity
            android:name=".ui.QuarantineActivity"
            android:exported="false"
            android:label="@string/title_quarantine" />

        <!-- Role-required compose entry point (default-SMS-handler role).
             Exported: other apps hand off ACTION_SENDTO compose requests with
             an sms:/smsto:/mms:/mmsto: data URI; the activity resolves the
             recipient, finds or creates the conversation, and opens the
             thread. BROWSABLE so browser-initiated sms: links can land here. -->
        <activity
            android:name=".ui.ComposeActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </activity>

        <!-- Inbound SMS. Part of the default-SMS-handler role: receives
             SMS_RECEIVED broadcasts and applies the auto-reply gate. -->
        <receiver
            android:name=".service.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Inbound MMS. Part of the default-SMS-handler role: receives
             WAP_PUSH_RECEIVED broadcasts and applies the audio-MMS drop. -->
        <receiver
            android:name=".service.MmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_RECEIVED" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>

        <!-- Primary inbound SMS delivery (default-SMS-handler role). When TxxT
             IS the default SMS app, the platform delivers messages here via
             SMS_DELIVER instead of SMS_RECEIVED; the SMS_RECEIVED receiver
             above covers the non-default case. Exported because only the
             system can invoke it: BROADCAST_SMS is signature-held by the
             platform. -->
        <receiver
            android:name=".service.SmsDeliverReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>

        <!-- Primary inbound MMS delivery (default-SMS-handler role). Same
             contract as SmsDeliverReceiver: used when TxxT IS the default SMS
             app. BROADCAST_WAP_PUSH is signature-held by the platform, so only
             the system can invoke it. -->
        <receiver
            android:name=".service.MmsDeliverReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>

        <!-- Theme auto-sync (T5). Exported so the xx-launcher (a separate app)
             can send its theme-change broadcast; the receiver routes the carried
             preset name through the manual-wins precedence rule and T6's applier
             re-applies the theme. Local only — an on-device broadcast
             between two apps on the same handset. -->
        <receiver
            android:name=".theme.ThemeSyncReceiver"
            android:exported="true"
            android:permission="com.piercingxx.xxlauncher.permission.THEME_SYNC">
            <intent-filter>
                <action android:name="xx.launcher.THEME_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Boot-time reconcile (T2). Runs RebootReconcile when the device
             finishes booting so unread counts and pending sends survive a
             reboot. -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Quick reply (notification action). Not exported: invoked only via
             the app's own notification PendingIntent, never by external apps. -->
        <receiver
            android:name=".service.NotificationReplyReceiver"
            android:exported="false" />

        <!-- Call-screen quick response (default-SMS-handler role). The
             platform's in-call UI starts this service to send a canned reply;
             SEND_RESPOND_VIA_MESSAGE is signature-held by the system, so only
             the platform can start it. The reply goes through SendPipeline. -->
        <!-- Writable cache URI for SmsManager.downloadMultimediaMessage. The
             telephony process writes the retrieved PDU here; grantUriPermission
             is issued per download. Not exported. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.mms"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/mms_file_paths" />
        </provider>

        <receiver
            android:name=".service.MmsDownloadedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.piercingxx.txxt.action.MMS_DOWNLOADED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".service.MmsSentReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.piercingxx.txxt.action.MMS_SENT" />
            </intent-filter>
        </receiver>

        <!-- Holds the process while SmsManager.downloadMultimediaMessage
             writes the PDU. Started from MmsDeliverReceiver.onReceive. -->
        <service
            android:name=".service.MmsRetrieveService"
            android:exported="false"
            android:foregroundServiceType="remoteMessaging" />

        <service
            android:name=".service.RespondViaMessageService"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
            </intent-filter>
        </service>

    </application>

</manifest>